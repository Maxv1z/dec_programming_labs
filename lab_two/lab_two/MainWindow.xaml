<Window x:Class="lab_two.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab_two"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
	<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
		<WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
			<Label Content="Label" VerticalAlignment="Center"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
		</WrapPanel>

		<WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
			<Label Content="Label" VerticalAlignment="Center"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
			<TextBox Width="80"/>
		</WrapPanel>

		<WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
			<Button Content="Button" Padding="10,5"/>
		</WrapPanel>
	</StackPanel>
</Window>
