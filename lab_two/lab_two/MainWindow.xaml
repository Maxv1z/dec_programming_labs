<Window x:Class="lab_two.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab_two"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
	<DockPanel>
		<TextBox DockPanel.Dock="Left" Width="190">Top</TextBox>
		<TextBox DockPanel.Dock="Right" Width="190">Right</TextBox>
		<Button DockPanel.Dock="Bottom">Button</Button>
		<Label >Label</Label>
	</DockPanel>
</Window>
