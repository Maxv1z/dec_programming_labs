<Window x:Class="lab_two.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab_two"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
	<Grid>
		<!-- Define two rows: one for the menu and one for the text area -->
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Auto height for the menu row -->
			<RowDefinition Height="*"/>
			<!-- Takes the remaining space for the text area -->
		</Grid.RowDefinitions>

		<Border Grid.Row="0" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10">
			<StackPanel Orientation="Horizontal">
				<Button ToolTip="Open">
					<Image Source="C:\Users\Max\Desktop\Dec prog labs\lab_two\lab_two\images\open_icon.png" Width="16" Height="16"/>
				</Button>
				<Button ToolTip="Clear">
					<Image Source="C:\Users\Max\Desktop\Dec prog labs\lab_two\lab_two\images\clear_icon.png" Width="16" Height="16"/>
				</Button>
				<Button ToolTip="Copy">
					<Image Source="C:\Users\Max\Desktop\Dec prog labs\lab_two\lab_two\images\copy_icon.png" Width="16" Height="16"/>
				</Button>
				<Button ToolTip="Paste">
					<Image Source="C:\Users\Max\Desktop\Dec prog labs\lab_two\lab_two\images\paste_icon.png" Width="16" Height="16"/>
				</Button>
			</StackPanel>
		</Border>

		<Border Grid.Row="1" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10">
			<Grid Margin="5">
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBox Grid.Row="0" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap"/>

				<DockPanel Grid.Row="1" Margin="0,5,0,0">
					<Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Padding="10,2" Content="OK"/>
				</DockPanel>
			</Grid>
		</Border>
	</Grid>
</Window>
